# ===== 运行环境 =====
# development / staging / production，仅用于标注与日志，不改变业务逻辑
APP_ENV=development
DEBUG=false

# ===== 存储 =====
# 一个根目录派生：库文件、media/、models/、uploads/ 都在它下面
# 容器里只需挂这一个卷
AIGC_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
# 换 PostgreSQL：pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/aigcavatar

# ===== 媒体 =====
# ffmpeg / ffprobe 在 PATH 里即可，也可以用绝对路径
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 单条 ffmpeg/ffprobe 命令的超时（秒），防止异常素材把 worker 卡死
AIGC_FFMPEG_TIMEOUT=300
AIGC_SAMPLE_RATE=24000
AIGC_WIDTH=720
AIGC_HEIGHT=1280
AIGC_FPS=2

# ===== 任务队列 =====
# 单 worker 顺序执行：对应单卡 GPU 的真实约束
AIGC_MAX_WORKERS=1
# 模拟模型下载每一步的耗时（秒），演示时调小
AIGC_DOWNLOAD_STEP=0.08

# ===== 真实模型接入（可选）=====
# 不配置时只能用内置引擎；配置后可在控制台选对应模型
# AIGC_COSYVOICE_300M_URL=http://127.0.0.1:9880
# AIGC_INDEX_TTS_URL=http://127.0.0.1:9881
# AIGC_MUSETALK_URL=http://127.0.0.1:9882
AIGC_REMOTE_TIMEOUT=120

# ===== 接入与可观测 =====
# 允许的跨域来源，逗号分隔；* 仅供本地开发
CORS_ORIGINS=*
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：text（本地阅读）/ json（采集到 Loki、ELK、CloudWatch）
LOG_FORMAT=text
# 请求关联 ID 的响应头名
REQUEST_ID_HEADER=X-Request-ID
# 是否暴露 /docs、/redoc、/openapi.json（生产建议关闭）
DOCS_ENABLED=true
