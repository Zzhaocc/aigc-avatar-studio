# ===== 服务 =====
DATABASE_URL=sqlite:///./data/studio.db
AIGC_MAX_WORKERS=1

# ===== 媒体 =====
# ffmpeg / ffprobe 在 PATH 里即可，也可以用绝对路径
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
AIGC_SAMPLE_RATE=24000
AIGC_WIDTH=720
AIGC_HEIGHT=1280
AIGC_FPS=2

# 模拟模型下载每一步的耗时（秒），演示时调小
AIGC_DOWNLOAD_STEP=0.08

# ===== 真实模型接入（可选）=====
# 不配置时只能用内置引擎；配置后可在控制台选对应模型
# AIGC_COSYVOICE_300M_URL=http://127.0.0.1:9880
# AIGC_INDEX_TTS_URL=http://127.0.0.1:9881
# AIGC_MUSETALK_URL=http://127.0.0.1:9882
# AIGC_REMOTE_TIMEOUT=120
